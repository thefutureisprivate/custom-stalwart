policy_module(particleos_stalwart, 1.0.0)

gen_require(`
    type systemd_importd_t;
')

type stalwart_t;
type stalwart_exec_t;
init_daemon_domain(stalwart_t, stalwart_exec_t)

# ParticleOS mounts the authenticated /usr payload nosuid and starts Stalwart
# with NoNewPrivileges=yes. Permit only PID 1's existing transition into this
# dedicated domain under those two kernel execution constraints.
allow init_t stalwart_t:process2 { nnp_transition nosuid_transition };

type stalwart_etc_t;
files_config_file(stalwart_etc_t)

type stalwart_state_t;
files_type(stalwart_state_t)

type stalwart_log_t;
logging_log_file(stalwart_log_t)

type stalwart_runtime_t;
files_pid_file(stalwart_runtime_t)

# PID 1 opens the selected signed DDI before transitioning the executable into
# stalwart_t. The image remains root-owned and read-only on the encrypted host
# root; its embedded PKCS#7 root-hash signature is the authorization boundary.
type stalwart_image_t;
files_type(stalwart_image_t)
allow init_t stalwart_image_t:dir list_dir_perms;
allow init_t stalwart_image_t:file read_file_perms;
allow init_t stalwart_image_t:lnk_file read_lnk_file_perms;
# systemd first probes whether a regular-file image can be opened writable and
# then falls back to the requested read-only loop device. Keep the protected
# image immutable without logging that expected fallback probe on every start.
dontaudit init_t stalwart_image_t:file write;

# systemd-sysupdate hands URL acquisition to the deliberately confined import
# helper. Give that domain a separate staging type instead of write access to
# the protected current/previous image store. PID 1's image manager validates
# the embedded signature and verity tree before copying a candidate into the
# protected type.
type stalwart_image_staging_t;
files_type(stalwart_image_staging_t)
allow init_t stalwart_image_staging_t:dir list_dir_perms;
allow init_t stalwart_image_staging_t:file read_file_perms;
allow systemd_importd_t stalwart_image_t:dir search_dir_perms;
manage_dirs_pattern(systemd_importd_t, stalwart_image_staging_t, stalwart_image_staging_t)
manage_files_pattern(systemd_importd_t, stalwart_image_staging_t, stalwart_image_staging_t)
filetrans_pattern(systemd_importd_t, stalwart_image_staging_t, stalwart_image_staging_t, { dir file })

# Only the host image manager may promote a verified candidate from importd's
# staging tree into the protected current/previous image store. Keep PID 1 and
# unrelated system services read-only on the store.
type stalwart_image_manager_t;
type stalwart_image_manager_exec_t;
init_daemon_domain(stalwart_image_manager_t, stalwart_image_manager_exec_t)
allow init_t stalwart_image_manager_t:process2 { nnp_transition nosuid_transition };

manage_dirs_pattern(stalwart_image_manager_t, stalwart_image_t, stalwart_image_t)
manage_files_pattern(stalwart_image_manager_t, stalwart_image_t, stalwart_image_t)
manage_lnk_files_pattern(stalwart_image_manager_t, stalwart_image_t, stalwart_image_t)
allow stalwart_image_manager_t stalwart_image_staging_t:dir list_dir_perms;
read_files_pattern(stalwart_image_manager_t, stalwart_image_staging_t, stalwart_image_staging_t)
delete_files_pattern(stalwart_image_manager_t, stalwart_image_staging_t, stalwart_image_staging_t)

type stalwart_image_manager_tmp_t;
files_tmp_file(stalwart_image_manager_tmp_t)
systemd_private_tmp(stalwart_image_manager_tmp_t)
manage_files_pattern(stalwart_image_manager_t, stalwart_image_manager_tmp_t, stalwart_image_manager_tmp_t)
files_tmp_filetrans(stalwart_image_manager_t, stalwart_image_manager_tmp_t, file)

# systemd-run --pipe passes the manager-opened private metadata output to the
# transient init_t verifier. PID 1 may use that descriptor and write only this
# ephemeral type; it still has no write access to the protected image store.
allow init_t stalwart_image_manager_t:fd use;
allow init_t stalwart_image_manager_tmp_t:file { getattr write append };

# systemd performs a second SELinux authorization check before it starts a
# transient RootImage unit. The refpolicy transient-unit interface covers the
# service class; current systemd also checks the system class explicitly.
# Permit only starting and observing the transient verifier through PID 1, not
# the other system operations. systemd-run --wait needs status to propagate the
# verifier's result back to the manager.
allow stalwart_image_manager_t init_t:system { start status };

allow stalwart_image_manager_t self:fifo_file rw_fifo_file_perms;
allow stalwart_image_manager_t self:process { getsched signal };
corecmd_exec_bin(stalwart_image_manager_t)
corecmd_exec_shell(stalwart_image_manager_t)
dbus_system_bus_client(stalwart_image_manager_t)
dev_read_urand(stalwart_image_manager_t)
fs_getattr_pidfs(stalwart_image_manager_t)
files_read_usr_files(stalwart_image_manager_t)
auth_read_passwd_file(stalwart_image_manager_t)
init_dbus_chat(stalwart_image_manager_t)
init_manage_transient_unit(stalwart_image_manager_t)
logging_send_syslog_msg(stalwart_image_manager_t)
miscfiles_read_localization(stalwart_image_manager_t)
systemd_exec_systemctl(stalwart_image_manager_t)

type stalwart_tmp_t;
files_tmp_file(stalwart_tmp_t)
systemd_private_tmp(stalwart_tmp_t)

# Runtime, state, and log data are private to the service account. Configuration
# and the WebUI are root-owned inputs in the immutable OS payload.
allow stalwart_t stalwart_etc_t:dir list_dir_perms;
read_files_pattern(stalwart_t, stalwart_etc_t, stalwart_etc_t)
read_lnk_files_pattern(stalwart_t, stalwart_etc_t, stalwart_etc_t)

manage_dirs_pattern(stalwart_t, stalwart_state_t, stalwart_state_t)
manage_files_pattern(stalwart_t, stalwart_state_t, stalwart_state_t)
manage_lnk_files_pattern(stalwart_t, stalwart_state_t, stalwart_state_t)

manage_dirs_pattern(stalwart_t, stalwart_log_t, stalwart_log_t)
manage_files_pattern(stalwart_t, stalwart_log_t, stalwart_log_t)

manage_dirs_pattern(stalwart_t, stalwart_runtime_t, stalwart_runtime_t)
manage_files_pattern(stalwart_t, stalwart_runtime_t, stalwart_runtime_t)
manage_sock_files_pattern(stalwart_t, stalwart_runtime_t, stalwart_runtime_t)

manage_dirs_pattern(stalwart_t, stalwart_tmp_t, stalwart_tmp_t)
manage_files_pattern(stalwart_t, stalwart_tmp_t, stalwart_tmp_t)
files_tmp_filetrans(stalwart_t, stalwart_tmp_t, { dir file })

allow stalwart_t self:fifo_file rw_fifo_file_perms;
allow stalwart_t self:process { getsched signal };
allow stalwart_t self:tcp_socket create_stream_socket_perms;

# Stalwart resolves through the host stub. nftables independently limits this
# DNS permission to systemd-resolved on loopback, whose only upstream path is
# authenticated DNS-over-TLS. Stalwart uses resolved's TCP proxy stub so its
# own DANE resolver can validate the preserved DNSSEC records locally.
sysnet_dns_name_resolve(stalwart_t)
systemd_chat_resolved(stalwart_t)

# The database is local-only and authenticates the stalwart Unix identity over
# PostgreSQL's labelled Unix socket. No TCP database permission is granted.
postgresql_stream_connect(stalwart_t)

# Inbound service ports: SMTP, implicit-TLS submission, implicit-TLS IMAP,
# HTTPS, and the loopback-only bootstrap HTTP listener. POP3 and ManageSieve
# port types are deliberately absent.
corenet_all_recvfrom_netlabel(stalwart_t)
corenet_all_recvfrom_unlabeled(stalwart_t)
corenet_tcp_sendrecv_generic_if(stalwart_t)
corenet_tcp_sendrecv_generic_node(stalwart_t)
corenet_tcp_bind_generic_node(stalwart_t)
corenet_tcp_bind_smtp_port(stalwart_t)
corenet_tcp_bind_cyrus_imapd_port(stalwart_t)
# Fedora labels TCP 993 as pop_port_t together with several legacy mail ports.
# This permission is required for IMAPS; Stalwart's compiled defaults and the
# host firewall independently ensure that no POP listener is created/exposed.
corenet_tcp_bind_pop_port(stalwart_t)
corenet_tcp_bind_http_port(stalwart_t)
corenet_tcp_bind_http_cache_port(stalwart_t)
corenet_tcp_sendrecv_smtp_port(stalwart_t)
corenet_tcp_sendrecv_cyrus_imapd_port(stalwart_t)
corenet_tcp_sendrecv_pop_port(stalwart_t)
corenet_tcp_sendrecv_http_port(stalwart_t)
corenet_tcp_sendrecv_http_cache_port(stalwart_t)

# Outbound delivery and Web PKI/ACME access. The host firewall applies the
# matching destination-port and per-service-UID limits.
corenet_tcp_connect_smtp_port(stalwart_t)
corenet_tcp_connect_http_port(stalwart_t)
corenet_sendrecv_smtp_client_packets(stalwart_t)
corenet_sendrecv_http_client_packets(stalwart_t)

dev_read_urand(stalwart_t)
logging_send_syslog_msg(stalwart_t)
miscfiles_read_generic_certs(stalwart_t)
miscfiles_map_generic_certs(stalwart_t)
miscfiles_read_localization(stalwart_t)
