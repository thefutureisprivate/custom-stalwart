+
+fn particleos_has_administrator_credential(account: &Account) -> bool {
+    matches!(
+        account,
+        Account::User(user)
+            if matches!(&user.roles, UserRoles::Admin)
+                && user.credentials.iter().any(|credential| matches!(
+                    credential,
+                    Credential::Password(password)
+                        if !password.secret.is_empty()
+                            && password.expires_at.is_none_or(|expiry| expiry > UTCDateTime::now())
+                ))
+    )
+}
