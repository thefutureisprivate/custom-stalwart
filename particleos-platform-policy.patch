+    fn particleos_dns_uses_resolved_proxy_over_tcp() {
+        match particleos_dns_resolver() {
+            DnsResolver::Custom(resolver) => {
+                let server = resolver.servers.values().next().unwrap();
+                assert_eq!(resolver.servers.len(), 1);
+                assert_eq!(server.protocol, DnsResolverProtocol::Tcp);
+                assert_eq!(server.address.to_string(), "127.0.0.54");
+                assert_eq!(server.port, 53);
+            }
+            _ => panic!("ParticleOS resolver must use the resolved proxy stub"),
+        }
+    }
