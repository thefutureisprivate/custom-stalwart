+        .take(20)
+        .map(char::from)
+        .collect::<String>();
+    eprintln!();
+    eprintln!("════════════════════════════════════════════════════════════");
+    eprintln!("🔑 Stalwart recovery mode - temporary administrator account");
+    eprintln!();
+    eprintln!("   username: admin");
+    eprintln!("   password: {password}");
+    eprintln!();
+    eprintln!("Use these credentials to complete the initial setup at the");
+    eprintln!("/admin web UI. Once setup is done, Stalwart will use the");
+    eprintln!("permanent administrator and this temporary account will no");
+    eprintln!("longer apply.");
+    eprintln!("════════════════════════════════════════════════════════════");
+    eprintln!();
+    ("admin".to_string(), password)
