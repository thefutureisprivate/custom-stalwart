# Stalwart environment overrides. This file is root-readable only.
#
# Required before the service can start with the packaged PostgreSQL config:
# STALWART_DB_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
#
# For initial recovery access, set a strong temporary credential here and
# remove it immediately after creating a permanent administrator:
# STALWART_RECOVERY_ADMIN=admin:REPLACE_WITH_A_RANDOM_PASSWORD
